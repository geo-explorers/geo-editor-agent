{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(node tools/doctor.mjs)",
      "Bash(node --env-file=.env tools/doctor.mjs)",
      "Bash(node --env-file=.env scripts/notion-read.mjs *)",
      "Bash(npm ci --ignore-scripts)",
      "PowerShell(node tools/doctor.mjs)",
      "PowerShell(node --env-file=.env tools/doctor.mjs)",
      "PowerShell(node --env-file=.env scripts/notion-read.mjs *)",
      "PowerShell(npm ci --ignore-scripts)"
    ],
    "ask": [
      "Bash(*--publish*)",
      "Bash(*--prune*)",
      "Bash(*--clear-root*)",
      "Bash(*CONFIRM_DESTRUCTIVE*)",
      "Bash(*--env-file*.env.geo-publish*)",
      "Bash(node *inject-publish-example*)",
      "Bash(node *publish_gaps*)",
      "Bash(node *build_dashboard*)",
      "Bash(node *sync-upstream*)",
      "Bash(node *export-docs*)",
      "Bash(git push *)",
      "Bash(npx *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "PowerShell(*--publish*)",
      "PowerShell(*--prune*)",
      "PowerShell(*--clear-root*)",
      "PowerShell(*CONFIRM_DESTRUCTIVE*)",
      "PowerShell(*--env-file*.env.geo-publish*)",
      "PowerShell(node *inject-publish-example*)",
      "PowerShell(node *publish_gaps*)",
      "PowerShell(node *build_dashboard*)",
      "PowerShell(node *sync-upstream*)",
      "PowerShell(node *export-docs*)",
      "PowerShell(git push *)",
      "PowerShell(npx *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm add *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "PowerShell(curl.exe *)",
      "PowerShell(wget *)"
    ]
  }
}
