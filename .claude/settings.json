{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(node tools/doctor.mjs)",
      "Bash(node --env-file=.env tools/doctor.mjs)",
      "Bash(node --env-file=.env scripts/notion-read.mjs *)",
      "Bash(node lib/gql-cli.mjs *)",
      "Bash(npm ci --ignore-scripts)"
    ],
    "ask": [
      "Bash(*--publish*)",
      "Bash(*--prune*)",
      "Bash(*--clear-root*)",
      "Bash(*CONFIRM_DESTRUCTIVE*)",
      "Bash(node *inject-publish-example*)",
      "Bash(node *publish_gaps*)",
      "Bash(node *build_dashboard*)",
      "Bash(*scripts/20*)",
      "Bash(git push *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(diff *)"
    ],
    "deny": [
      "PowerShell",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Bash(curl *)",
      "Bash(curl.exe *)",
      "Bash(wget *)"
    ]
  }
}
